<UserControl x:Class="RealFenixFailures.UI.Views.Panels.RealisticModePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:RealFenixFailures.UI.ViewModels" d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="MODO REALISTA" FontSize="10" FontWeight="Bold"
                       Foreground="{StaticResource Brush.Accent.Amber.Primary}"/>
            <TextBlock Text="El sistema monitorea el historial de vuelos y genera fallas de forma autónoma basándose en el desgaste acumulado. No hay interacción manual."
                       FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}"
                       TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Stats cards -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#0D0F14" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="VUELOS" FontSize="9" FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Text.Secondary}"/>
                        <TextBlock Text="{Binding TotalFlights}" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Text.Primary}" Margin="0,4,0,0"/>
                        <TextBlock Text="registrados" FontSize="10"
                                   Foreground="{StaticResource Brush.Text.Secondary}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#0D0F14" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="HORAS" FontSize="9" FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Text.Secondary}"/>
                        <TextBlock Text="{Binding TotalFlightHours, StringFormat='{}{0:F1}'}"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Text.Primary}" Margin="0,4,0,0"/>
                        <TextBlock Text="acumuladas" FontSize="10"
                                   Foreground="{StaticResource Brush.Text.Secondary}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#0D0F14" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="FALLAS" FontSize="9" FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Text.Secondary}"/>
                        <TextBlock Text="{Binding TotalFailuresTriggered}"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Accent.Amber.Primary}" Margin="0,4,0,0"/>
                        <TextBlock Text="generadas" FontSize="10"
                                   Foreground="{StaticResource Brush.Text.Secondary}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Wear bars -->
            <Border Grid.Row="1" Background="#0D0F14" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="DESGASTE DE SISTEMAS" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,12"/>

                    <!-- Engine 1 -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Motor 1" FontSize="11"
                                   Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Column="1" Style="{StaticResource WearBarStyle}"
                                     Minimum="0" Maximum="100"
                                     Value="{Binding Engine1WearPercent}"
                                     Foreground="{Binding Engine1WearBrush}"
                                     VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Engine1WearPercent, StringFormat='{}{0}%'}"
                                   FontSize="11" Foreground="{StaticResource Brush.Text.Primary}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Engine 2 -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Motor 2" FontSize="11"
                                   Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Column="1" Style="{StaticResource WearBarStyle}"
                                     Minimum="0" Maximum="100"
                                     Value="{Binding Engine2WearPercent}"
                                     Foreground="{Binding Engine2WearBrush}"
                                     VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Engine2WearPercent, StringFormat='{}{0}%'}"
                                   FontSize="11" Foreground="{StaticResource Brush.Text.Primary}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Hydraulics -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Hidr\u00e1ulico" FontSize="11"
                                   Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Column="1" Style="{StaticResource WearBarStyle}"
                                     Minimum="0" Maximum="100"
                                     Value="{Binding HydraulicsWearPercent}"
                                     Foreground="{Binding HydraulicsWearBrush}"
                                     VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding HydraulicsWearPercent, StringFormat='{}{0}%'}"
                                   FontSize="11" Foreground="{StaticResource Brush.Text.Primary}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Connection warning -->
            <Border Grid.Row="2"
                    Background="#2A1C0A" BorderBrush="#F59E0B" BorderThickness="1"
                    CornerRadius="8" Padding="12"
                    Visibility="{Binding ShowConnectionWarning, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠" FontSize="16" Foreground="{StaticResource Brush.Accent.Amber.Primary}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Conectá MSFS 2024 y Fenix A320 para activar el modo realista."
                               FontSize="12" Foreground="{StaticResource Brush.Accent.Amber.Primary}"
                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Toggle button -->
        <Button Grid.Row="2" Height="48" Margin="0,16,0,0"
                Command="{Binding ToggleRealisticModeCommand}"
                IsEnabled="{Binding CanStartEngine}">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource SuccessButtonStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEngineActive}" Value="True">
                            <Setter Property="Background" Value="#7F1D1D"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" FontSize="16" Margin="0,0,10,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="⏵"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEngineActive}" Value="True">
                                    <Setter Property="Text" Value="⏹"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="ACTIVAR MODO REALISTA"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEngineActive}" Value="True">
                                    <Setter Property="Text" Value="DETENER MODO REALISTA"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Button>
    </Grid>
</UserControl>