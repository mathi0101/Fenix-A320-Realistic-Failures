<UserControl x:Class="RealFenixFailures.UI.Views.Panels.TrainingModePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:RealFenixFailures.UI.ViewModels" d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="MODO ENTRENAMIENTO" FontSize="10" FontWeight="Bold"
                       Foreground="{StaticResource Brush.Accent.Blue.Primary}"/>
            <TextBlock Text="Seleccioná un escenario para practicar procedimientos de emergencia."
                       FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}"
                       TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding TrainingScenarios}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Style="{StaticResource ScenarioItemStyle}"
                                     IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                     GroupName="TrainingScenario"
                                     Command="{Binding DataContext.SelectTrainingScenarioCommand,
                                                               RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     CommandParameter="{Binding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Text.Primary}"/>
                                    <TextBlock Text="{Binding Description}" FontSize="11"
                                               Foreground="{StaticResource Brush.Text.Secondary}"
                                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <Border Background="#1A2540" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding Phase}" FontSize="10"
                                                       Foreground="{StaticResource Brush.Accent.Blue.Primary}"/>
                                        </Border>
                                        <Border Background="#1A2A1A" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding Difficulty}" FontSize="10"
                                                       Foreground="{StaticResource Brush.Accent.Green.Primary}"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="▶" FontSize="14"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <Border Background="#0D0F14" CornerRadius="8" Padding="14" Margin="0,0,0,12"
                    Visibility="{Binding HasSelectedTrainingScenario, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="ESCENARIO SELECCIONADO" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource Brush.Text.Secondary}"/>
                    <TextBlock Text="{Binding SelectedTrainingScenario.Name}" FontSize="14"
                               FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}"
                               Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding SelectedTrainingScenario.TriggerDescription}"
                               FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Button Content="{Binding TrainingStartText}"
                    Command="{Binding StartTrainingScenarioCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Height="40"
                    IsEnabled="{Binding CanStartTraining}"/>
        </StackPanel>
    </Grid>
</UserControl>