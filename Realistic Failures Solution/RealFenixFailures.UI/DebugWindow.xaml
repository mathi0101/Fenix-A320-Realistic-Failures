<Window x:Class="RealFenixFailures.UI.DebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Realistic A320 Fenix Failures" Height="720" Width="500" MinHeight="720" MinWidth="800">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="285*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12" Grid.ColumnSpan="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="MSFS2024 (SimConnect)" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SimConnectStatus}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Fenix A320" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding FenixStatus}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Fase de vuelo" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CurrentFlightPhase}" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.RowSpan="2" Grid.ColumnSpan="1" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,12,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Presets" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding PresetType}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding FailureCount, StringFormat='Fallas: {0}'}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        

        <Border BorderThickness="1" CornerRadius="8" Padding="12" Margin="12" Grid.Column="1" Grid.RowSpan="2" Grid.Row="1">
            <StackPanel>
                <TextBlock Text="Controles" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                <Button Content="Refrescar" Command="{Binding RefreshCommand}" Height="20" Margin="5,4" />
                <Button Height="25" Command="{Binding ToggleEngineCommand}" Content="{Binding EngineToggleText}" Margin="5,4" />

                <TextBlock Text="Configuración" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Text="Probabilidad global (0-1)" />
                <TextBox Text="{Binding GlobalProbability, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
                <TextBlock Text="Intervalo de chequeo (seg)" />
                <TextBox Text="{Binding CheckIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
                <Button Content="Aplicar configuración" Command="{Binding ApplySettingsCommand}" Height="32" />

                <Border BorderThickness="1" CornerRadius="8" Padding="0" Margin="0,20,0,0" Height="284">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Log en tiempo real" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ListBox ItemsSource="{Binding LogEntries}" MinHeight="200" />
                    </DockPanel>
                </Border>
            </StackPanel>
            
        </Border>
    </Grid>
</Window>