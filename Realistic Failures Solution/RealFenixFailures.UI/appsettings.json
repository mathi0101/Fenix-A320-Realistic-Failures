{
  "ConnectionStrings": {
    "Sqlite": "Data Source=realfenixfailures.db"
  },
  "FailureEngine": {
    "GlobalProbability": 0.1,
    "CheckIntervalSeconds": 10,
    "ForcedFlightPhaseForStub": 5,
    "FailuresJson": "failures.json",
    "TrainingPresetsJson": "training_presets.json"
  },
  "FenixApi": {
    "BaseUrl": "http://192.168.1.69",
    "Port": 8083,
    "ManualFailuresPath": "/fenix/failures/manual",
    "SaveManualPath": "/fenix/failures/saveManual",
    "HealthCheckIntervalSeconds": 10,
    "HealthCheckTimeout": 2
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/realfenix-.log",
          "rollingInterval": "Day"
        }
      },
      { "Name": "Debug" } // opcional: también enviar a Output window
    ]
  }
}